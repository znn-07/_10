// File name: projects/02/HalfAdder.hdl

/**
 * Computes the sum of two bits.
 */

// Half Adder: sum = A XOR B, carry = A AND B

CHIP HalfAdder {
    IN a, b;    // 1-bit inputs
    OUT sum,    // 本位的和
        carry;  // 進位到高位

    PARTS:
    // Put your code here:
    Xor(a=a, b=b, out=sum);
    And(a=a, b=b, out=carry);
}
